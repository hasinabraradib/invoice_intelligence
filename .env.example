# Copy to .env and adjust. NEVER commit .env. Every value here is a placeholder.

# --- PostgreSQL container (used by docker-compose to create the database) ---
POSTGRES_USER=invoice
POSTGRES_PASSWORD=change-me
POSTGRES_DB=invoices

# --- Application ---
# Must match the POSTGRES_* values above. Host "postgres" is the compose service name.
DATABASE_URL=postgresql+asyncpg://invoice:change-me@postgres:5432/invoices
REDIS_URL=redis://redis:6379/0

# LLM backend: none | gemini | groq | openai. "none" lets the stack run without a key.
LLM_PROVIDER=none
# Your Gemini (aistudio.google.com) or Groq (console.groq.com) key. Never commit it.
LLM_API_KEY=
# Your OpenAI key (platform.openai.com/api-keys), used when LLM_PROVIDER=openai. Never commit it.
OPENAI_API_KEY=
# Empty = provider default (gemini-2.5-flash / openai/gpt-oss-120b / gpt-6-luna).
LLM_MODEL=
# OpenAI reasoning effort: none | low. "none" lets gpt-6-luna keep temperature 0; with
# "low" it rejects temperature 0, so the client drops it (output is then less repeatable).
OPENAI_REASONING_EFFORT=none
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=4
# Provider requests in flight at once per process, over all jobs. Use 1-2 on free tiers.
LLM_MAX_CONCURRENT_REQUESTS=4
LLM_CHUNK_TOKENS=6000
# Prices in USD per million tokens, for the cost estimate in `make eval` (empty = no cost).
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=

# Upload limits and storage location (inside the container).
MAX_UPLOAD_MB=20
UPLOAD_DIR=/data/uploads
MAX_FILES_PER_REQUEST=20

# Parsing caps (protect memory/CPU against huge documents)
MAX_PDF_PAGES=2000
MAX_SHEET_ROWS=10000
MAX_SHEET_COLUMNS=200

# OCR (Tesseract). Installed languages: eng, ben. Combine with "+", e.g. eng+ben.
OCR_ENABLED=true
OCR_LANGS=eng
OCR_MIN_CONFIDENCE=60
OCR_PAGE_TIMEOUT_SECONDS=60
OCR_DPI=300
# Parallel OCR processes; leave unset for (CPU cores - 1)
# OCR_WORKERS=4

# Validation
MONEY_TOLERANCE=0.01
REVIEW_CONFIDENCE=0.6

# Background jobs (arq worker)
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=10
JOB_TIMEOUT_BASE_SECONDS=120
JOB_TIMEOUT_PER_PAGE_SECONDS=15
JOB_TIMEOUT_MAX_SECONDS=3600
WORKER_CONCURRENCY=2
STUCK_JOB_MINUTES=30
# Hard timeout per call of each CPU-heavy step (its process is killed on timeout)
PARSE_TIMEOUT_SECONDS=300
OCR_TASK_TIMEOUT_SECONDS=180
EMBED_TIMEOUT_SECONDS=60
EMBED_BATCH_CHUNKS=64
# Watchdog: heartbeat interval while a job makes progress; the worker exits (and Docker
# restarts it) if its event loop stops ticking for this long
HEARTBEAT_SECONDS=30
WORKER_LOOP_STALL_SECONDS=120

# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:3000"]

# Semantic search (local model, no API key; downloaded once into the "models" volume)
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_CHUNK_TOKENS=500
EMBED_CHUNK_OVERLAP=50
SEMANTIC_MIN_SIMILARITY=0.20

# Frontend: the API address as the BROWSER sees it (baked in at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Batch documents (many invoices in one PDF)
SEGMENT_CONCURRENCY=4
SEGMENT_CLASSIFIER_BATCH=20
