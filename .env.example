# Copy to .env and adjust. NEVER commit .env. Every value here is a placeholder.

# --- PostgreSQL container (used by docker-compose to create the database) ---
POSTGRES_USER=invoice
POSTGRES_PASSWORD=change-me
POSTGRES_DB=invoices

# --- Application ---
# Must match the POSTGRES_* values above. Host "postgres" is the compose service name.
DATABASE_URL=postgresql+asyncpg://invoice:change-me@postgres:5432/invoices
REDIS_URL=redis://redis:6379/0

# LLM backend: none | gemini | groq. "none" lets the stack run without a key.
LLM_PROVIDER=none
# Your Gemini (aistudio.google.com) or Groq (console.groq.com) key. Never commit it.
LLM_API_KEY=
# Empty = provider default (gemini-2.5-flash / openai/gpt-oss-120b)
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=4
LLM_CHUNK_TOKENS=6000

# Upload limits and storage location (inside the container).
MAX_UPLOAD_MB=20
UPLOAD_DIR=/data/uploads
MAX_FILES_PER_REQUEST=20

# Parsing caps (protect memory/CPU against huge documents)
MAX_PDF_PAGES=2000
MAX_SHEET_ROWS=10000
MAX_SHEET_COLUMNS=200

# OCR (Tesseract). Installed languages: eng, ben. Combine with "+", e.g. eng+ben.
OCR_ENABLED=true
OCR_LANGS=eng
OCR_MIN_CONFIDENCE=60
OCR_PAGE_TIMEOUT_SECONDS=60
OCR_DPI=300
