# Secrets
.env
.env.*
!.env.example

# Uploaded documents (may contain personal/financial data)
uploads/

# Python
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Node / frontend
node_modules/
.next/
dist/
build/

# Editors / OS
.vscode/
.idea/
.DS_Store

# Real sample invoices: keep only the README
samples/*
!samples/README.md

# Frontend build and test output
frontend/playwright-report/
frontend/test-results/
frontend/coverage/
*.tsbuildinfo

# Evaluation: rendered dataset files are regenerated by `make eval-dataset`
eval/dataset/files/
# Real invoices for evaluation stay local (personal/financial data); only the template is kept
eval/dataset/real/*
!eval/dataset/real/labels.json

# Logs and local tool output (raw test reports are kept on purpose in docs/test-results/)
*.log
.gitleaks-report*

# Walkthrough video output (video files are never committed)
walkthrough-output/
*.mp4
*.webm
